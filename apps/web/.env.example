# Copy to .env.local for local dev (Vite loads .env.local automatically; it's gitignored).
# In production these are set in the Vercel project's Environment Variables dashboard.

# The game server's WebSocket URL (ws:// locally, wss:// in production). The /auth/* and
# /rankings HTTP endpoints are derived from this (same host/port, http(s):// instead).
VITE_SERVER_URL=ws://localhost:8787

# Google OAuth 2.0 "Web application" Client ID (public value, not a secret) — create one
# in Google Cloud Console and add Authorized JavaScript origins for this app's domain(s).
# Leave empty to disable "Sign in with Google" (email/password sign-in still works).
VITE_GOOGLE_CLIENT_ID=
